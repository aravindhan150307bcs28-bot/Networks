#include <stdlib.h>
#include <stdbool.h>

// Simple hash table implementation to count distinct values
#define HASH_SIZE 1000003

typedef struct Node {
    int key;
    struct Node* next;
} Node;

typedef struct {
    Node* buckets[HASH_SIZE];
    int count;
} HashTable;

void hash_insert(HashTable* table, int key) {
    // Map negative numbers or large values to valid array bounds
    unsigned int hash_index = ((unsigned int)key) % HASH_SIZE;
    Node* curr = table->buckets[hash_index];
    
    // Check if key already exists
    while (curr != NULL) {
        if (curr->key == key) return;
        curr = curr->next;
    }
    
    // Key not found, insert new element
    Node* new_node = (Node*)malloc(sizeof(Node));
    new_node->key = key;
    new_node->next = table->buckets[hash_index];
    table->buckets[hash_index] = new_node;
    table->count++;
}

void free_hash_table(HashTable* table) {
    for (int i = 0; i < HASH_SIZE; i++) {
        Node* curr = table->buckets[i];
        while (curr != NULL) {
            Node* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    if (arrSize == 0) return 0;

    HashTable global_set = { {NULL}, 0 };

    // Set storage buffers tracking current and previous iteration steps
    int prev_or_values[33];
    int current_or_values[33];
    int prev_size = 0;

    for (int i = 0; i < arrSize; i++) {
        int current_size = 0;
        
        // Base combination: element i by itself
        current_or_values[current_size++] = arr[i];
        hash_insert(&global_set, arr[i]);

        // Evaluate variations with all subarrays ending at i-1
        for (int j = 0; j < prev_size; j++) {
            int new_or = prev_or_values[j] | arr[i];
            
            // Avoid inserting duplicates into the localized window set
            if (new_or != current_or_values[current_size - 1]) {
                current_or_values[current_size++] = new_or;
                hash_insert(&global_set, new_or);
            }
        }

        // Move current states to previous array tracker for the next iteration
        for (int j = 0; j < current_size; j++) {
            prev_or_values[j] = current_or_values[j];
        }
        prev_size = current_size;
    }

    int total_distinct = global_set.count;
    
    // Prevent memory leaks
    free_hash_table(&global_set);

    return total_distinct;
}


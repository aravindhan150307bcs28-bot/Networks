#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/*
 * Complete the 'addBinary' function below.
 * Time Complexity: O(max(N, M)) - Linear pass over strings 'a' and 'b'.
 * Space Complexity: O(max(N, M)) - Output string allocation layout.
 */
char* addBinary(char* a, char* b) {
    int len_a = strlen(a);
    int len_b = strlen(b);
    
    // The max length of the result can be max(len_a, len_b) + 1 (for an extra carry)
    int max_len = (len_a > len_b ? len_a : len_b) + 1;
    
    // Allocate space for the result string + 1 for null-terminator
    char* result = (char*)malloc((max_len + 1) * sizeof(char));
    if (!result) return NULL;
    
    result[max_len] = '\0'; // Set the null-terminator at the end
    
    int i = len_a - 1;
    int j = len_b - 1;
    int k = max_len - 1;
    int carry = 0;
    
    // Loop from right to left until all digits and carry are processed
    while (i >= 0 || j >= 0 || carry > 0) {
        int sum = carry;
        
        if (i >= 0) {
            sum += a[i] - '0'; // Convert char digit to integer
            i--;
        }
        if (j >= 0) {
            sum += b[j] - '0';
            j--;
        }
        
        result[k] = (sum % 2) + '0'; // Current binary digit ('0' or '1')
        carry = sum / 2;             // Calculate new carry
        k--;
    }
    
    // If the loop finished and didn't use the very first slot (no overflow carry),
    // we shift the pointer forward to ignore the unused leading space.
    if (k == 0) {
        // Move the whole string content one step left to clear the empty front slot
        memmove(result, result + 1, max_len);
    }
    
    return result;
}

int main() {
    // Test Case 1
    char* a1 = "11";
    char* b1 = "1";
    char* res1 = addBinary(a1, b1);
    printf("Input: a = \"%s\", b = \"%s\" -> Output: \"%s\"\n", a1, b1, res1); // Expected: "100"
    free(res1);

    // Test Case 2
    char* a2 = "1010";
    char* b2 = "1011";
    char* res2 = addBinary(a2, b2);
    printf("Input: a = \"%s\", b = \"%s\" -> Output: \"%s\"\n", a2, b2, res2); // Expected: "10101"
    free(res2);

    return 0;
}


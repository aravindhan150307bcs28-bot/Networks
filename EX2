#include <stdbool.h>

/*
 * LeetCode 693: Binary Number with Alternating Bits
 * Time Complexity: O(1)
 * Space Complexity: O(1)
 */
bool hasAlternatingBits(int n) {
    // Shift n right by 1 and XOR with n.
    // If bits alternate, x will be a number composed entirely of 1s (e.g., 1111).
    unsigned int x = (unsigned int)n ^ ((unsigned int)n >> 1);
    
    // Check if x + 1 clears all bits to 0 when ANDed with x
    return (x & (x + 1)) == 0;
}


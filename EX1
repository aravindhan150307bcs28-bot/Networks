#include <stdio.h>
#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller frees it.
 */
int* countBits(int n, int* returnSize) {
    // The result array needs to be of size n + 1 (from 0 to n inclusive)
    *returnSize = n + 1;
    
    int* ans = (int*)malloc((*returnSize) * sizeof(int));
    if (!ans) {
        return NULL;
    }

    // Base case
    ans[0] = 0;

    // Dynamic Programming: state transition relation
    for (int i = 1; i <= n; i++) {
        // ans[i] = ans[i / 2] + (1 if i is odd, 0 if even)
        ans[i] = ans[i >> 1] + (i & 1);
    }

    return ans;
}

int main() {
    int n = 5;
    int returnSize;
    
    // Call the function
    int* result = countBits(n, &returnSize);

    // Print output array
    printf("Input n: %d\n", n);
    printf("Output: [");
    for (int i = 0; i < returnSize; i++) {
        printf("%d", result[i]);
        if (i < returnSize - 1) {
            printf(",");
        }
    }
    printf("]\n");

    // Clean up dynamic memory
    free(result);

    return 0;
}


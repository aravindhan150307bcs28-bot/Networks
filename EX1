#include <stdio.h>
#include <stdlib.h>

/*
 * Complete the 'findComplement' function below.
 * Time Complexity: O(1) - The loop runs at most 31 times.
 * Space Complexity: O(1) - Constant auxiliary space.
 */
int findComplement(int num) {
    // If num is 0, its complement is 1
    if (num == 0) return 1;

    unsigned int mask = 0;
    unsigned int temp = num;

    // Create a bitmask of 1s matching the bit length of num
    while (temp > 0) {
        mask = (mask << 1) | 1;
        temp >>= 1;
    }

    // XORing with the mask flips all the bits up to the highest set bit
    return num ^ mask;
}

int main() {
    // Test Case 1
    int test1 = 5;
    printf("Input: %d, Complement: %d\n", test1, findComplement(test1)); // Expected: 2

    // Test Case 2
    int test2 = 1;
    printf("Input: %d, Complement: %d\n", test2, findComplement(test2)); // Expected: 0

    // Test Case 3 (Constraint maximum edge case)
    int test3 = 2147483647; // 2^31 - 1
    printf("Input: %d, Complement: %d\n", test3, findComplement(test3)); // Expected: 0

    return 0;
}

